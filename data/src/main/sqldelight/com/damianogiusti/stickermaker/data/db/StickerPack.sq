CREATE TABLE sticker_pack (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    publisher TEXT NOT NULL,
    tray_file_name TEXT,
    image_data_version INTEGER NOT NULL DEFAULT 1,
    is_available_in_keyboard INTEGER NOT NULL DEFAULT 0,
    keyboard_added_at INTEGER,
    is_imported INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL
);

CREATE TABLE sticker (
    pack_id TEXT NOT NULL REFERENCES sticker_pack(id) ON DELETE CASCADE,
    file_name TEXT NOT NULL,
    emojis TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (pack_id, file_name)
);

CREATE INDEX sticker_pack_id_position ON sticker(pack_id, position);

selectPacks:
SELECT * FROM sticker_pack ORDER BY position ASC, id ASC;

selectPackById:
SELECT * FROM sticker_pack WHERE id = ?;

selectStickers:
SELECT * FROM sticker ORDER BY pack_id, position ASC;

selectStickersByPack:
SELECT * FROM sticker WHERE pack_id = ? ORDER BY position ASC;

selectNextPackPosition:
SELECT COALESCE(MAX(position), -1) + 1 FROM sticker_pack;

selectNextStickerPosition:
SELECT COALESCE(MAX(position), -1) + 1 FROM sticker WHERE pack_id = ?;

selectPackExists:
SELECT COUNT(*) FROM sticker_pack WHERE id = ?;

selectStickerExists:
SELECT COUNT(*) FROM sticker WHERE pack_id = ? AND file_name = ?;

insertPack:
INSERT INTO sticker_pack(id, name, publisher, tray_file_name, image_data_version, is_available_in_keyboard, keyboard_added_at, is_imported, position)
VALUES (?, ?, ?, NULL, 1, 0, NULL, 0, ?);

updateNames:
UPDATE sticker_pack SET name = ?, publisher = ? WHERE id = ?;

updateTray:
UPDATE sticker_pack SET tray_file_name = ? WHERE id = ?;

bumpImageDataVersion:
UPDATE sticker_pack SET image_data_version = image_data_version + 1 WHERE id = ?;

updateKeyboardAvailability:
UPDATE sticker_pack SET is_available_in_keyboard = ?, keyboard_added_at = ? WHERE id = ?;

deletePack:
DELETE FROM sticker_pack WHERE id = ?;

insertSticker:
INSERT INTO sticker(pack_id, file_name, emojis, size_bytes, position) VALUES (?, ?, '', ?, ?);

replaceStickerFile:
UPDATE sticker SET file_name = ?, size_bytes = ? WHERE pack_id = ? AND file_name = ?;

deleteSticker:
DELETE FROM sticker WHERE pack_id = ? AND file_name = ?;

updateEmojis:
UPDATE sticker SET emojis = ? WHERE pack_id = ? AND file_name = ?;

selectSticker:
SELECT * FROM sticker WHERE pack_id = ? AND file_name = ?;

shiftPositionsAfter:
UPDATE sticker SET position = position - 1 WHERE pack_id = ? AND position > ?;

insertFullPack:
INSERT INTO sticker_pack(id, name, publisher, tray_file_name, image_data_version, is_available_in_keyboard, keyboard_added_at, is_imported, position)
VALUES (?, ?, ?, ?, 1, ?, ?, ?, ?);

insertStickerWithEmojis:
INSERT INTO sticker(pack_id, file_name, emojis, size_bytes, position) VALUES (?, ?, ?, ?, ?);
