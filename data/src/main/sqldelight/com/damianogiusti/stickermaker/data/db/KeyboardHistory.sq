CREATE TABLE keyboard_history (
    pack_id TEXT NOT NULL REFERENCES sticker_pack(id) ON DELETE CASCADE,
    file_name TEXT NOT NULL,
    used_at INTEGER NOT NULL,
    PRIMARY KEY (pack_id, file_name)
);

CREATE INDEX keyboard_history_used_at ON keyboard_history(used_at);

selectHistory:
SELECT * FROM keyboard_history ORDER BY used_at DESC, rowid DESC LIMIT ?;

upsertEntry:
INSERT OR REPLACE INTO keyboard_history(pack_id, file_name, used_at) VALUES (?, ?, ?);

trim:
DELETE FROM keyboard_history WHERE rowid NOT IN (
    SELECT rowid FROM keyboard_history ORDER BY used_at DESC, rowid DESC LIMIT ?
);
